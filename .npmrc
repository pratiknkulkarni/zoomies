# expo-router 57.0.9 depends on react-dom 19.2.8, which peer-requires react
# ^19.2.8, while Expo SDK 57 pins react at 19.2.3. react-dom is only used by the
# router's web entry, which this project does not target (TECH_STACK.md 2.1).
# Keep react on the version the SDK expects and let npm resolve past the skew.
legacy-peer-deps=true
