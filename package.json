{
  "name": "zoomies",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "apk": "android/gradlew -p android assembleDebug -PreactNativeArchitectures=${ZOOMIES_ABI:-arm64-v8a}",
    "apk:release": "android/gradlew -p android assembleRelease -PreactNativeArchitectures=${ZOOMIES_ABI:-arm64-v8a}",
    "deploy": "npm run apk && adb ${ZOOMIES_DEVICE:+-s $ZOOMIES_DEVICE} install -r android/app/build/outputs/apk/debug/app-debug.apk && npm run reverse",
    "deploy:release": "npm run apk:release && adb ${ZOOMIES_DEVICE:+-s $ZOOMIES_DEVICE} install -r android/app/build/outputs/apk/release/app-release.apk",
    "reverse": "adb ${ZOOMIES_DEVICE:+-s $ZOOMIES_DEVICE} reverse tcp:8081 tcp:8081",
    "device": "adb ${ZOOMIES_DEVICE:+-s $ZOOMIES_DEVICE} shell getprop ro.product.model"
  },
  "dependencies": {
    "@expo-google-fonts/geist": "^0.4.2",
    "@expo-google-fonts/geist-mono": "^0.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "expo": "~57.0.9",
    "expo-constants": "~57.0.8",
    "expo-dev-client": "~57.0.10",
    "expo-font": "~57.0.1",
    "expo-haptics": "^57.0.1",
    "expo-keep-awake": "^57.0.1",
    "expo-linking": "~57.0.4",
    "expo-router": "~57.0.9",
    "expo-splash-screen": "~57.0.5",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "lucide-react-native": "^1.28.0",
    "nativewind": "^4.2.6",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1",
    "tailwind-merge": "^3.6.0",
    "uuidv7": "^1.2.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "babel-plugin-inline-import": "^3.0.0",
    "babel-preset-expo": "~57.0.5",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.1",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  }
}
